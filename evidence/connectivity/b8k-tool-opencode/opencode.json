{
  "update": "disable",
  "share": "disabled",
  "snapshots": false,
  "model": "local/docker.io/local/qwen35-4b:8k",
  "default_agent": "capability_probe",
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "fixture.txt",
      "effect": "allow"
    }
  ],
  "policies": [
    {
      "action": "tool.use",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "integration.use",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "read:fixture.txt",
      "effect": "allow"
    }
  ],
  "agents": {
    "title": {
      "disabled": true
    },
    "capability_probe": {
      "mode": "primary",
      "steps": 3,
      "system": "Use read exactly once on fixture.txt, then state the actual failing assertion. No other tools or files."
    }
  },
  "providers": {
    "local": {
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://192.168.0.62:18035/v1",
        "timeout": 120000
      },
      "models": {
        "docker.io/local/qwen35-4b:8k": {
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "output": 512,
            "context": 8192
          },
          "body": {
            "chat_template_kwargs": {
              "enable_thinking": false
            },
            "temperature": 0
          }
        }
      }
    }
  }
}